{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recs84.github.io/longevity-cell-therapy-weekly/schema/issue.schema.json",
  "title": "Longevity Cell Therapy Weekly issue",
  "description": "One weekly issue of a curated cell therapy and longevity research feed for AI agents. Summaries are based on public abstracts unless summary_basis says otherwise. Not medical advice.",
  "type": "object",
  "required": [
    "feed",
    "issue",
    "sources",
    "search_queries",
    "license_note",
    "disclaimer",
    "items"
  ],
  "properties": {
    "feed": {
      "type": "object",
      "required": [
        "name",
        "slug",
        "publisher",
        "schema_version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "name_alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "publisher": {
          "type": "string"
        },
        "editor": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schema": {
          "type": "string"
        },
        "schema_version": {
          "type": "string"
        }
      }
    },
    "issue": {
      "type": "object",
      "required": [
        "number",
        "date_range",
        "generated_at",
        "item_count"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string"
        },
        "date_range": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "format": "date"
            },
            "end": {
              "type": "string",
              "format": "date"
            },
            "timezone": {
              "type": "string"
            }
          }
        },
        "date_basis": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "item_count": {
          "type": "integer",
          "minimum": 0
        },
        "selection_method": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "endpoint"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "endpoint": {
            "type": "string"
          },
          "records": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "search_queries": {
      "type": "object"
    },
    "license_note": {
      "type": "string"
    },
    "disclaimer": {
      "type": "string"
    },
    "editor_note": {
      "type": [
        "object",
        "null"
      ]
    },
    "cross_item_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "funnel": {
      "type": [
        "object",
        "null"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "authors",
        "source",
        "peer_reviewed",
        "url",
        "doi",
        "posted_date",
        "topic_tags",
        "study_type",
        "finding",
        "key_readouts_or_biomarkers",
        "manufacturing_relevance",
        "limitations",
        "evidence_strength",
        "why_it_matters_for_builders"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^lctw-[0-9]{3}-[0-9]{2}$"
        },
        "title": {
          "type": "string"
        },
        "authors": {
          "type": "string",
          "description": "First author, last author, and total count, or et al."
        },
        "source": {
          "type": "string",
          "description": "Journal or preprint server."
        },
        "peer_reviewed": {
          "type": "boolean"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "doi": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        },
        "posted_date": {
          "type": "string",
          "format": "date",
          "description": "Online publication or preprint posting date (Crossref or server)."
        },
        "indexed_date": {
          "type": "string",
          "format": "date",
          "description": "Date first indexed by PubMed, Europe PMC or the preprint server API."
        },
        "catch_up": {
          "type": "boolean",
          "description": "True if posted before the issue window but first indexed inside it."
        },
        "summary_basis": {
          "type": "string",
          "description": "abstract, or full text where available."
        },
        "topic_tags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "minItems": 1
        },
        "study_type": {
          "type": "string",
          "enum": [
            "in vitro",
            "animal",
            "human",
            "review",
            "methods"
          ],
          "description": "Primary experimental system. Mixed designs (for example patient samples plus mouse work) are described in finding and readouts."
        },
        "finding": {
          "type": "string",
          "description": "One plain-language sentence, only what the source states."
        },
        "key_readouts_or_biomarkers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Only readouts stated in the source."
        },
        "manufacturing_relevance": {
          "type": [
            "string",
            "null"
          ],
          "description": "Scale, process or potency assay notes; null if none."
        },
        "limitations": {
          "type": "string"
        },
        "evidence_strength": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "reason"
          ],
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "why_it_matters_for_builders": {
          "type": "string"
        }
      }
    }
  }
}